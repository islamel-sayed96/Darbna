# Hostinger's shared-hosting "Deploy from GitHub" feature on the Business
# plan can't point the site's document root at the public/ subfolder (that
# requires a VPS plan), so the whole repo ends up served from public_html.
# This routes every request into public/ instead, where Laravel's own
# public/.htaccess takes over — so app/, vendor/, .env etc. are never
# served directly; a request for them just falls through to Laravel's
# router (404) instead of being read as a raw file.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
